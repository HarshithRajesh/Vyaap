# ═══════════════════════════════════════════════════════════════
#  Vyaap — Root .gitignore
#  Covers: Go backend · React extension · Python AI agent · Infra
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# 🔐 SECRETS & ENVIRONMENT — NEVER commit these
# ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# ──────────────────────────────────────────────────────────────
# 🟦 GO (backend/)
# ──────────────────────────────────────────────────────────────
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.darwin-amd64
*.darwin-arm64
*.linux-amd64
*.linux-arm64
*.windows-amd64

# Go build output
/backend/bin/
/backend/build/
/backend/dist/
backend/tmp/

# Go dependency vendor (we use go.sum, not vendor)
vendor/

# Go test artifacts
*.test
*.out
/backend/test_results/

# Go workspace (local only)
go.work
go.work.sum

# ──────────────────────────────────────────────────────────────
# ⚛️  REACT / NODE (extension-react/)
# ──────────────────────────────────────────────────────────────
# Dependencies — never commit these
node_modules/
.npm/
.yarn/
.pnp.*

# Vite / build cache
.vite/
.vite-cache/

# Local dev server state
*.local

# TypeScript incremental build cache
*.tsbuildinfo

# Windows-only build helpers (we're on Linux)
*.bat
*.cmd

# ──────────────────────────────────────────────────────────────
# 📦 BUILD OUTPUT (extension/dashboard-react/)
# ──────────────────────────────────────────────────────────────
# The compiled React bundle — generated by `npm run build`
# DO NOT ignore if you want dashboard-react served from the repo.
# Uncomment the line below to ignore it (requires manual build step).
# extension/dashboard-react/

# ──────────────────────────────────────────────────────────────
# 🐍 PYTHON (ai-agent/)
# ──────────────────────────────────────────────────────────────
# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Package build artifacts
*.egg-info/
*.egg
dist/
build/
.eggs/

# Pytest cache
.pytest_cache/
.tox/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# uv (Python package manager)
# uv.lock is intentionally committed (like package-lock.json)

# ──────────────────────────────────────────────────────────────
# 🐳 INFRA / DOCKER
# ──────────────────────────────────────────────────────────────
# Docker secrets / override compose files
docker-compose.override.yml
docker-compose.local.yml

# ──────────────────────────────────────────────────────────────
# 🖥️ OS GENERATED FILES
# ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ──────────────────────────────────────────────────────────────
# 🛠️ IDE & EDITOR FILES
# ──────────────────────────────────────────────────────────────
# VS Code (keep .vscode/extensions.json if you want to share recommendations)
.vscode/
!.vscode/extensions.json

# JetBrains (GoLand, IntelliJ, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
\#*\#
*~
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────────────────────
# 🧩 CHROME EXTENSION PACKAGING
# ──────────────────────────────────────────────────────────────
*.crx
*.zip
*.xpi

# ──────────────────────────────────────────────────────────────
# 📝 LOGS & TEMP FILES
# ──────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.temp/
.tmp/

# ──────────────────────────────────────────────────────────────
# 🗃️ MISC
# ──────────────────────────────────────────────────────────────
# Debug / profiling artifacts
*.pdb
*.prof

# Cargo (Rust — leftover from old .gitignore template)
debug/
target/
**/*.rs.bk
**/mutants.out*/

# Todo files (local dev notes)
Todo.md