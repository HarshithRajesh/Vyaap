GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Backend pushes to queues matching: vyaap:queue:raw_chats:{userId}:{chatName}
REDIS_INPUT_PATTERN=vyaap:queue:raw_chats:*

# Pipeline publishes invoices to: vyaap:invoices:{userId}
REDIS_INVOICE_PREFIX=vyaap:invoices
REDIS_ERROR_PREFIX=vyaap:errors
REDIS_DEDUP_PREFIX=vyaap:processed_batches

CONFIDENCE_THRESHOLD=0.5
PROCESSED_TTL_HOURS=24
POLL_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
LOG_FILE=ai_pipeline_v2.log
